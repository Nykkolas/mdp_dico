<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseAvalonia>true</UseAvalonia>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.FuncUI" Version="2.0.0" />
    <PackageReference Include="Avalonia.FuncUI.Elmish" Version="2.0.0" />
    <PackageReference Include="Elmish" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MdpDico.Core\mdp_dico.fsproj" />
  </ItemGroup>

  <ItemGroup><Compile Include="Main.fs" />
    <!-- MainWindow doit être compilé AVANT App -->
    
    <Compile Include="App.fs" />
  </ItemGroup>

</Project>
